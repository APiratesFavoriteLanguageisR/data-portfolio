# Slim base: small image, Linux (no Windows path-length limit), pinned for reproducibility
FROM python:3.12-slim

# Avoid interactive prompts, ensure clean Python behavior in containers
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Work inside a dedicated directory
WORKDIR /app

# Install dependencies FIRST, as their own layer, so code changes don't
# invalidate the (slow) dependency install on every rebuild.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Now copy the application code
COPY src/ ./src/

# The pipeline expects config.yaml and the service-account key at runtime,
# both MOUNTED as volumes (see docker run command), never copied into the image.
# GOOGLE_APPLICATION_CREDENTIALS points at the mounted key path inside the container.

# Run the pipeline
CMD ["python", "-m", "src.main"]